ZENITH_RPC_URL=https://rpc.testnet.zenith.network/
ZENITH_CHAIN_ID=936485
# Address of the deployer and the name of its encrypted Foundry keystore (cast wallet import <name> --interactive)
DEPLOYER_ADDRESS=0x...
DEPLOYER_ACCOUNT=zenith-deployer
# Liquidator wallet for demo 2 (create once: cast wallet new zenith-liquidator)
LIQUIDATOR=0x...
LIQUIDATOR_ACCOUNT=zenith-liquidator
